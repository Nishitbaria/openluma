# Database
DATABASE_URL=postgresql://user:password@localhost:5432/openluma

# Better Auth
BETTER_AUTH_SECRET=generate-a-random-secret-here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (optional — remove if not using Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Resend (for email notifications)
RESEND_API_KEY=re_your_resend_api_key

# Uploadthing (for file uploads)
UPLOADTHING_TOKEN=your-uploadthing-token

# AI Provider
OPENAI_API_KEY=sk-your-openai-api-key

# Cron job security (generate with: openssl rand -hex 32)
CRON_SECRET=your-cron-secret-here
